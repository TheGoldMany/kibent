# --- Neon Postgres (projekt: kibent-oltp) ---------------------------------
# Neon konzol → kibent-oltp → Connect → "Pooled connection" (…-pooler…neon.tech)
DATABASE_URL=postgresql://neondb_owner:********@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Bejelentkezés (saját Better Auth) ---------------------------------------
# Legalább 32 karakteres véletlen titok: openssl rand -base64 32
# (Ha nincs megadva, a korábbi NEON_AUTH_COOKIE_SECRET értéket használja.)
BETTER_AUTH_SECRET=
# Opcionális: további címek, ahonnan a belépés engedélyezett (vesszővel elválasztva).
# Az egyedi domain, a www változat és a Vercel címek automatikusan engedélyezettek.
AUTH_TRUSTED_ORIGINS=

# --- Vercel Blob (privát store az orvosi igazolásokhoz) ---------------------
# Vercel → Storage → Blob → Create (Private) → Connect to project; helyileg: vercel env pull
BLOB_READ_WRITE_TOKEN=

# --- Email (meghívók) – Resend, https://resend.com ---------------------------
# Ha üres, a meghívók akkor is elkészülnek, a linket az admin kézzel másolja ki.
RESEND_API_KEY=
# A feladó domainjét a Resendben hitelesíteni kell (pl. kibent.hu)
EMAIL_FROM="Kibent <meghivo@kibent.hu>"

# --- Alkalmazás -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
